msgid "Synchronization Settings"
msgstr "Sinchronizacijos nustatymai"

msgid "Full Sync Time"
msgstr "Pilno sinchronizavimo laikas"

msgid "Time of night when full sync is performed with RASO, if set to 00:00, then full sync is turned off."
msgstr "Nakties laikas, kada pilnas sinchronizavimas vykdomas su RASO, jei nustatytas 00:00, tada pilnas sinchronizavimas yra išjungtas."

msgid "Fetch Sales Interval (Minutes)"
msgstr "Pardavimų gavimo intervalas (minutės)"

msgid "Cron job interval to fetch sales documents from RASO to ERPNext. If set to 0, then automatic fetching is turned off."
msgstr "Cron užduoties intervalas pardavimų dokumentų gavimui iš RASO į ERPNext. Jei nustatytas 0, automatinis gavimas bus išjungtas."

msgid "Cron job interval to check for data to send to RASO. If set to 0, then automatic sending is turned off. If it more than 60 minutes, it will be rounded down to hourly intervals."
msgstr "Cron užduoties intervalas duomenų tikrinimui, kurie turi būti siunčiami į RASO. Jei nustatytas 0, automatinis siuntimas bus išjungtas. Jei jis viršija 60 minučių, jis bus suapvalintas iki valandinių intervalų."

msgid "Send Check Interval (Minutes)"
msgstr "Siuntimų tikrinimo intervalas (minutės)"

msgid "Enqueue Sending Minimum Delay (Minutes)"
msgstr "Minimalaus siuntimo į eilę vėlavimas (minutės)"

msgid "Delay between enqueuing item sends to RASO to avoid multiple records and overload, in minutes."
msgstr "Vėlavimas tarp prekių siuntimo į RASO eilę, siekiant išvengti kelių įrašų ir perkrovos, minutėmis."

msgid "Auto Submit Sales Documents"
msgstr "Automatiškai patvirtinti pardavimų dokumentus"

msgid "Synchronization is Running"
msgstr "Sinchronizacija vykdoma"

msgid "System flag indicating if synchronization is currently in progress"
msgstr "Sistemos vėliavėlė, rodanti ar sinchronizacija šiuo metu vykdoma"

msgid "Working Hours"
msgstr "Darbo valandos"

msgid "Working Hours From"
msgstr "Darbo valandos nuo"

msgid "Start time to fetch sales documents when business hours begin"
msgstr "Pradžios laikas pardavimų dokumentų gavimui, kai prasideda darbo valandos"

msgid "Working Hours To"
msgstr "Darbo valandos iki"

msgid "End time to stop fetching sales documents when business hours end"
msgstr "Pabaigos laikas pardavimų dokumentų gavimo sustabdymui, kai baigiasi darbo valandos"

msgid "Payment Method Mapping"
msgstr "Mokėjimo metodų siejimas"

msgid "Add Payments to Imported Records"
msgstr "Pridėti mokėjimus prie importuotų įrašų"

msgid "If checked, payments imported from RASO will be linked to their corresponding Sales Invoices in ERPNext."
msgstr "Jei pažymėta, iš RASO importuoti mokėjimai bus susieti su atitinkamomis pardavimų sąskaitomis faktūromis ERPNext."

