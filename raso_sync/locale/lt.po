msgid "Raso Sync"
msgstr "RASO sinchronizacija"

msgid "Manage and monitor RASO Sync status from this overview page."
msgstr "Tvarkykite ir stebėkite RASO sinchronizacijos būseną šiame puslapyje."

# API Messages

msgid "Database connection settings are incomplete"
msgstr "Duomenų bazės prisijungimo nustatymai neišsamūs"

msgid "Connection successful"
msgstr "Prisijungimas sėkmingas"

msgid "Connection test failed: {0}"
msgstr "Prisijungimo testas nepavyko: {0}"

msgid "Synchronization is already running. Please wait for it to complete."
msgstr "Sinchronizacija jau vykdoma. Palaukite, kol ji baigsis."

msgid "Uploaded {0} using {1} mode"
msgstr "Įkelta {0} naudojant {1} režimą"

msgid "Fetched {0}"
msgstr "Gauta {0}"

msgid "Manual upload failed: {0}"
msgstr "Rankinis įkėlimas nepavyko: {0}"

msgid "Manual fetch failed: {0}"
msgstr "Rankinis gavimas nepavyko: {0}"

msgid "Unknown data type: {0}"
msgstr "Nežinomas duomenų tipas: {0}"

