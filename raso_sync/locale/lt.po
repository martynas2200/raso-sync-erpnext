msgstr "Darbo valandos"

msgid "Working Hours From"
msgstr "Darbo valandos nuo"

msgid "Start time to fetch sales documents when business hours begin"
msgstr "Pradžios laikas pardavimų dokumentų gavimui, kai prasideda darbo valandos"

msgid "Working Hours To"
msgstr "Darbo valandos iki"

msgid "End time to stop fetching sales documents when business hours end"
msgstr "Pabaigos laikas pardavimų dokumentų gavimo sustabdymui, kai baigiasi darbo valandos"

msgid "Payment Method Mapping"
msgstr "Mokėjimo metodų siejimas"

