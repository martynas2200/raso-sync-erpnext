    {
      "fieldname": "sql_client_settings_section",
      "fieldtype": "Section Break",
      "label": "Synchronization Settings",
      "description": "These settings define synchronization intervals and behavior on the <b>ERPNext side only</b>. RASO RETAIL (RR) has its own independent schedulers.<br>In other words, ERPNext sends data to the secondary RR database, and RR updates its main database within 10 (default setting) minutes. <br>RR exports new data to the secondary database every 20 (default setting) minutes, meaning if a sale is made in RR, it may take up to 20 minutes before it exported, and then an additional interval defined here before it appears in ERPNext."
    },
    {
      "fieldname": "full_sync_time",
      "fieldtype": "Time",
      "label": "Full Sync Time",
      "default": "06:23",
      "description": "Time of night when full sync is performed with RASO, if set to 00:00, then full sync is turned off."
    },
    {
      "fieldname": "fetch_sales_interval_minutes",
      "fieldtype": "Int",
      "label": "Fetch Sales Interval (Minutes)",
      "default": "0",
      "description": "Cron job interval to fetch sales documents from RASO to ERPNext. If set to 0, then automatic fetching is turned off.",
      "non_negative": 1
    },
    {
      "fieldname": "submit_sales_documents",
      "fieldtype": "Check",
      "label": "Auto Submit Sales Documents",
      "default": 1
    },
    {
      "fieldname": "column_break_8",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "send_check_interval_minutes",
      "fieldtype": "Int",
      "label": "Send Check Interval (Minutes)",
      "default": "0",
      "description": "Cron job interval to check for data to send to RASO. If set to 0, then automatic sending is turned off. If it more than 60 minutes, it will be rounded down to hourly intervals.",
      "non_negative": 1
    },
    {
      "fieldname": "synchronization_is_running",
      "fieldtype": "Check",
      "label": "Synchronization Is Running",
      "read_only": 1,
      "description": "System flag indicating if synchronization is currently in progress"
    },
